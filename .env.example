# Copy this file to .env.local for local development. Do not commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DATABASE?sslmode=require
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
# Resend sender setup. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=Northstar <invitations@your-verified-domain.com>